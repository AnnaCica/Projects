<Window x:Class="CatTrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cat Trap"
        Width="900"
        Height="820"
        MinWidth="850"
        MinHeight="750"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9EB">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--HEADER -->
        <Border Grid.Row="0"
                Background="#F0F3DC"
                Padding="20,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- THIS WILL BE THE RESTART BUTTON -->
                <Border Grid.Column="0"
                        Background="#B8F500"
                        CornerRadius="15"
                        Padding="22,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                    <TextBlock Text="NEW GAME"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#182000"/>
                </Border>

                <!-- Moves -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="15,0">

                    <TextBlock Text="Moves"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="#526044"/>

                    <TextBlock x:Name="MovesText"
                               Text="0"
                               FontSize="20"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Margin="15,0"/>
                </StackPanel>

                <!-- Best ? if we want to store those -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="15,0">

                    <TextBlock Text="Best"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Foreground="#526044"/>

                    <TextBlock x:Name="BestText"
                               Text="1"
                               FontSize="20"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Margin="15,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- GAME BOARD -->
        <Grid Grid.Row="1">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                <Canvas x:Name="GameCanvas"
                        Width="820"
                        Height="680"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
